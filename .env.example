# Public site URL used for canonical links, sitemap, and Open Graph.
SITE_URL=https://www.mintxsolutions.com

# Required before admin login works. Use a long random string.
SESSION_SECRET=

# First admin account. Created on the first successful configuration check.
# Change this password after the first login. Do not use these placeholders in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional. Inquiries are always saved in the admin dashboard.
# If these are set, a notification email is attempted after a successful save.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=mintxsolution@gmail.com
